{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/launcher-icon-20260906.png",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/online-count",
      "destination": "https://ouk-khmer-backend-production-8a36.up.railway.app/api/online-count"
    },
    {
      "source": "/api/leaderboard",
      "destination": "https://ouk-khmer-backend-production-8a36.up.railway.app/api/leaderboard"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/play",
      "destination": "/index.html"
    },
    {
      "source": "/online",
      "destination": "/index.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/history",
      "destination": "/index.html"
    },
    {
      "source": "/tactics",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/pieces/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
